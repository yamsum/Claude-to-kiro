{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Graphify: Build Knowledge Graph",
      "type": "shell",
      "command": "python -m graphify .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Graphify: Update Knowledge Graph",
      "type": "shell",
      "command": "python -m graphify . --update",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Graphify: Open Report",
      "type": "shell",
      "command": "cat graphify-out/GRAPH_REPORT.md",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
