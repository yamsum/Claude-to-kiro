{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Graphify: Build Knowledge Graph",
      "type": "shell",
      "command": "python -m graphify .",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Graphify: Update Knowledge Graph",
      "type": "shell",
      "command": "python -m graphify . --update",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "QA: Unit Tests",
      "type": "shell",
      "command": "ng test --no-watch --code-coverage",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "QA: E2E Tests",
      "type": "shell",
      "command": "ng e2e",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "QA: Lint",
      "type": "shell",
      "command": "ng lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": ["$eslint-compact"]
    },
    {
      "label": "QA: Full Suite",
      "dependsOn": ["QA: Lint", "QA: Unit Tests"],
      "dependsOrder": "sequence",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
